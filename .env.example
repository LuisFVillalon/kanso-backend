# Postgres. On Supabase use the pooler URL: Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed if the project still signs JWTs with HS256
# SUPABASE_JWT_SECRET=

# Encrypts stored Canvas tokens: 32 random bytes, base64. Generate with
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# In production: fly secrets set CANVAS_TOKEN_KEY=<key>
CANVAS_TOKEN_KEY=

# Optional: Google Calendar import. Set all three, and CANVAS_TOKEN_KEY, to turn it on.
# From a Google Cloud OAuth client of type "Web application"; the redirect URI is
# this API's /google-calendar/callback and must be listed on the client.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-api.fly.dev/google-calendar/callback

# Optional: comma-separated CORS origins
# ALLOWED_ORIGINS=http://localhost:3000,https://kanso-web-app.vercel.app
